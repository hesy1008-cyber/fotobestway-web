generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  category     String
  image        String
  overview     String
  features     Json
  applications Json
  specs        Json
  coverImage   String?
  description  String?
  detailImages Json?
  gallery      Json?
  createdAt    DateTime @default(now())
}
